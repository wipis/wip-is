---
// Both icons ship in the markup and cross-fade off the `dark` class on <html>,
// so the toggle is correct on first paint with no mount-state dance. The
// accessible label is set by src/lib/theme.ts.
---

<button
  type="button"
  data-mode-toggle
  aria-label="Toggle color mode"
  class="mode-toggle grid size-11 -m-3 place-items-center text-[var(--app-fg-muted)] hover:text-[var(--app-fg)]"
>
  <svg
    data-icon="moon"
    class="mode-icon col-start-1 row-start-1 h-4 w-4"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg
    data-icon="sun"
    class="mode-icon col-start-1 row-start-1 h-4 w-4"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"
    ></path>
  </svg>
</button>

<style>
  /* Color hover animates always (a single control, not a list); the press
     scale is motion, so it only runs when motion is allowed. The button box is
     44px for the tap target, pulled back with a negative margin so the footer
     layout is unchanged. */
  .mode-toggle {
    transition: color 0.15s ease-out;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mode-toggle {
      transition:
        color 0.15s ease-out,
        scale 0.2s ease-out;
    }

    .mode-toggle:active {
      scale: 0.97;
    }
  }

  .mode-icon {
    will-change: transform, opacity, filter;
  }

  /* Light (default): sun shown, moon parked small + blurred. */
  [data-icon="moon"] {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }
  [data-icon="sun"] {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  /* Dark: reverse. */
  :global(html.dark) [data-icon="moon"] {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }
  :global(html.dark) [data-icon="sun"] {
    opacity: 0;
    transform: scale(0.25);
    filter: blur(4px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mode-icon {
      transition:
        opacity 0.2s ease-out,
        transform 0.2s ease-out,
        filter 0.2s ease-out;
    }
  }
</style>

<script>
  import { toggleTheme } from "~/lib/theme";

  for (const toggle of document.querySelectorAll("[data-mode-toggle]")) {
    toggle.addEventListener("click", () => toggleTheme());
  }
</script>
