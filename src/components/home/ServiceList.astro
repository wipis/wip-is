---
import type { SERVICES } from "~/lib/work";

interface Props {
  label: string;
  groups: typeof SERVICES;
}

const { label, groups } = Astro.props;
---

<div class="text-[var(--app-fg)] leading-relaxed">
  <span class="section-label block text-[var(--app-fg-muted)]">{label}</span>
  <ul>
    {
      groups.map(({ group, items, mobile }) => (
        <li>
          <span class="text-[var(--app-fg-muted)]">{group},</span>{" "}
          {items.map((item, i) => (
            <span class={mobile.includes(item) ? undefined : "max-md:hidden"}>{i ? ", " : ""}{item}</span>
          ))}
        </li>
      ))
    }
  </ul>
</div>
