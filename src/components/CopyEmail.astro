---
import { CONTACT_EMAIL } from "~/lib/constants";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span class="contents">
  <button
    type="button"
    data-copy-email
    data-email={CONTACT_EMAIL}
    class={`inline-block font-light text-[var(--app-fg)] cursor-pointer transition-[color,scale] duration-200 ease-out motion-safe:active:scale-[0.97] ${className}`}
    >{CONTACT_EMAIL}</button
  >
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</span>

<script>
  const COPIED_DURATION = 2000;

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-email]"
  )) {
    const email = button.dataset.email;
    if (!email) continue;

    const status = button.parentElement?.querySelector<HTMLElement>(
      "[data-copy-status]"
    );

    let timeout: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      try {
        // Falls back to the mail client when the Clipboard API is missing or
        // blocked (insecure context, denied permission).
        if (!navigator.clipboard?.writeText) throw new Error("no clipboard");

        await navigator.clipboard.writeText(email);

        button.textContent = "Copied";
        if (status) status.textContent = "Email address copied";
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          button.textContent = email;
          if (status) status.textContent = "";
        }, COPIED_DURATION);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
