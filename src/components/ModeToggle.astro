---
// Both icons ship in the markup and CSS picks the right one off the `dark`
// class on <html>. That keeps the toggle correct on first paint without any
// mount-state dance. The accessible label is set by src/lib/theme.ts.
---

<button
  type="button"
  data-mode-toggle
  aria-label="Toggle color mode"
  class="inline-flex items-center justify-center text-[var(--app-fg-muted)] hover:text-[var(--app-fg)] transition-colors"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="hidden h-4 w-4 dark:block"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="h-4 w-4 dark:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"
    ></path>
  </svg>
</button>

<script>
  import { toggleTheme } from "~/lib/theme";

  for (const toggle of document.querySelectorAll("[data-mode-toggle]")) {
    toggle.addEventListener("click", () => toggleTheme());
  }
</script>
