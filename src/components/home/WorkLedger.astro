---
import { LINK_CLASSNAME } from "~/lib/constants";
import type { WorkItem } from "~/lib/work";

interface Props {
  label: string;
  items: WorkItem[];
}

const { label, items } = Astro.props;

// Newest first, like an exhibition list. Undated items sink to the bottom.
const sorted = [...items].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
---

<div class="text-[var(--app-fg)] leading-relaxed">
  <span class="block text-[var(--app-fg-muted)]">{label} —</span>
  <ul>
    {
      sorted.map((item) => (
        <li>
          {item.year && (
            <span class="text-[var(--app-fg-muted)] tabular-nums">
              {item.year},{" "}
            </span>
          )}
          {item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class={LINK_CLASSNAME}
            >
              {item.company}
            </a>
          ) : (
            <span>{item.company}</span>
          )}
          {item.project && <span>, {item.project}</span>}
        </li>
      ))
    }
  </ul>
</div>
