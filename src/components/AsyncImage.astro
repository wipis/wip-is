---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { src, alt, class: className, loading = "lazy" } = Astro.props;
---

<div data-async-image class:list={["async-image", className]} style={`aspect-ratio: ${src.width} / ${src.height}`}>
  <Image src={src} alt="" aria-hidden="true" width={64} quality={30} loading={loading} class="image-preview" />
  <Image src={src} alt={alt} loading={loading} decoding="async" class="image-full" />
</div>

<style>
  .async-image { position: relative; overflow: hidden; }
  .image-preview,
  .image-full { display: block; width: 100%; height: 100%; object-fit: contain; }
  .image-preview {
    position: absolute;
    inset: 0;
    filter: blur(4px);
    transform: scale(1.015);
    pointer-events: none;
  }
  .image-full { position: relative; }
  /* Without JS, the full image stays visible and loads normally. */
  [data-loading] .image-full { opacity: 0; }
  [data-loaded] .image-full { opacity: 1; }
</style>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>("[data-async-image]")) {
    const image = frame.querySelector<HTMLImageElement>(".image-full")!;
    // Cached images display immediately. Loaded state persists across slides.
    if (image.complete && image.naturalWidth) {
      frame.setAttribute("data-loaded", "");
      continue;
    }

    frame.setAttribute("data-loading", "");
    image.addEventListener("load", async () => {
      try {
        await image.decode();
        requestAnimationFrame(() => requestAnimationFrame(() => {
          frame.setAttribute("data-loaded", "");
        }));
      } catch {
        // Keep the small preview available if the full image fails to decode.
      }
    }, { once: true });
  }
</script>
