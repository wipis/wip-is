---
import CopyEmail from "~/components/CopyEmail.astro";
import HandleList from "~/components/home/HandleList.astro";
import WorkLedger from "~/components/home/WorkLedger.astro";
import ServiceList from "~/components/home/ServiceList.astro";
import TextList from "~/components/home/TextList.astro";
import { CONTACT_EMAIL, LINK_CLASSNAME } from "~/lib/constants";
import {
  CREDITS,
  SERVICES,
  SOCIAL_ITEMS,
  WORK_ITEMS,
} from "~/lib/work";
---

<section aria-label="Selected work" class="grid gap-4">
  <ServiceList label="Services" groups={SERVICES} />
  <WorkLedger label="Work" items={WORK_ITEMS} />
  <HandleList label="Social" items={SOCIAL_ITEMS}>
    <li slot="prefix">
      Work Email: <CopyEmail label={CONTACT_EMAIL} class={LINK_CLASSNAME} />
    </li>
  </HandleList>
  <TextList label="Credits" items={CREDITS} />
</section>
