---
import Base from "~/layouts/Base.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import HomeAbout from "~/components/home/HomeAbout.astro";
import HomeIntro from "~/components/home/HomeIntro.astro";
import StarMarks from "~/components/home/StarMarks.astro";
import WorkList from "~/components/home/WorkList.astro";
import WorkGallery from "~/components/home/WorkGallery.astro";
---

<Base>
  <main
    id="main"
    tabindex="-1"
    class="home-page bg-[--app-bg] min-h-screen scroll-mt-6 text-[--app-fg]"
  >
    <SiteHeader />

    <article class="relative z-40 grid gap-9 md:h-dvh md:grid-cols-[minmax(0,33rem)_minmax(0,1fr)] md:gap-0 md:overflow-hidden">
      <div
        role="region"
        aria-label="Studio information"
        tabindex="0"
        data-scroll-pane
        class="min-h-0 px-6 pt-24 md:overflow-y-auto md:overscroll-contain md:border-r md:border-[var(--app-border)] md:pb-24"
      >
        <div class="grid max-w-[30rem] gap-6 text-[1.0625rem]">
          <HomeIntro />
          <HomeAbout />
          <WorkList />
          <StarMarks />
        </div>
      </div>

      <div
        role="region"
        aria-label="Work imagery"
        tabindex="0"
        data-scroll-pane
        class="min-h-0 min-w-0 px-6 pb-24 md:overflow-y-auto md:overscroll-contain md:pt-6"
      >
        <WorkGallery />
      </div>
    </article>

    <SiteFooter />
  </main>
</Base>

<style>
  @media (min-width: 768px) {
    .home-page :global(footer) {
      width: 33rem;
    }
  }
</style>
