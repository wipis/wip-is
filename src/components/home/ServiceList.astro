---
import type { SERVICES } from "~/lib/work";

interface Props {
  label: string;
  groups: typeof SERVICES;
}

const { label, groups } = Astro.props;
---

<div class="text-[var(--app-fg)] leading-relaxed">
  <span class="block text-[var(--app-fg-muted)]">{label} —</span>
  <dl class="grid grid-cols-[6.5rem_1fr]">
    {
      groups.map(({ group, items }) => (
        <>
          <dt class="text-[var(--app-fg-muted)]">{group}</dt>
          <dd>{items.join(", ")}</dd>
        </>
      ))
    }
  </dl>
</div>
