---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import AsyncImage from "../AsyncImage.astro";
import { WORK_IMAGES } from "~/lib/work-posts";
import WorkShotCarousel from "./WorkShotCarousel.astro";

const images = import.meta.glob<ImageMetadata>("/src/assets/work/*.{png,jpg,webp}", { eager: true, import: "default" });
const themed = (path: string, theme: "dark" | "light") => images[path.replace("{theme}", theme)]!;
---

<div class="grid gap-9">
  {WORK_IMAGES.length ? WORK_IMAGES.map((post, index) => <figure>
    {post.images && post.images.length > 1 ? <WorkShotCarousel
      shots={post.images.map((path) => path.includes("{theme}") ? { light: themed(path, "light"), dark: themed(path, "dark") } : { light: images[path] })}
      label={post.company}
      alt={post.imageAlt!}
      eager={index === 0}
    /> : post.images?.length ? <div class="grid gap-3">
      {/* Each shot comes in a dark and a light version; the one matching the site's theme shows. The first image's alt describes the set. */}
      {post.images.map((path, i) => path.includes("{theme}") ? <>
        <AsyncImage src={themed(path, "light")} alt={i ? "" : post.imageAlt!} class="block h-auto w-full dark:hidden" loading={index || i ? "lazy" : "eager"} />
        <AsyncImage src={themed(path, "dark")} alt={i ? "" : post.imageAlt!} class="hidden h-auto w-full dark:block" loading={index || i ? "lazy" : "eager"} />
      </> : <AsyncImage src={images[path]!} alt={i ? "" : post.imageAlt!} class="block h-auto w-full" loading={index || i ? "lazy" : "eager"} />)}
    </div> : <AsyncImage src={images[post.image!]} alt={post.imageAlt!} class="block h-auto w-full" loading={index ? "lazy" : "eager"} />}
    <figcaption class="mt-3 text-sm leading-snug">
      {post.caption || post.project}
    </figcaption>
  </figure>) : <figure>
    <Image src="/work-placeholder.svg" alt="Placeholder showing an open publication on a black background" width={1440} height={960} class="block aspect-[3/2] w-full object-cover" />
    <figcaption class="mt-3 text-sm leading-snug">
      <span class="block">01 / Work in progress</span>
      <span class="text-[var(--app-fg-muted)]">Selected work · Image placeholder</span>
    </figcaption>
  </figure>}
</div>
