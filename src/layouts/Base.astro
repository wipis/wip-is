---
import "~/styles/globals.css";
import "lenis/dist/lenis.css";

// Resolved to the same hashed asset the @font-face in globals.css points at, so
// the preload below and the CSS request are one and the same fetch.
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

import ConsoleMessage from "~/components/ConsoleMessage.astro";
import {
  BRAND_NAME,
  CONTACT_EMAIL,
  COPYRIGHT_NAME,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_URL,
  SOCIAL_LINKS,
} from "~/lib/constants";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const ogImageUrl = `${SITE_URL}${OG_IMAGE_PATH}`;
const imageAlt = "WIP — Design and Engineering Studio by Bridger Tower";
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: BRAND_NAME,
      alternateName: "WIP",
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
    {
      "@type": "ProfessionalService",
      name: BRAND_NAME,
      alternateName: "WIP",
      url: SITE_URL,
      email: CONTACT_EMAIL,
      description: SITE_DESCRIPTION,
      image: ogImageUrl,
      founder: {
        "@type": "Person",
        name: COPYRIGHT_NAME,
        url: "https://bridger.to",
      },
      sameAs: [...SOCIAL_LINKS],
    },
  ],
};
---

<html lang="en" class="bg-[var(--app-bg)] font-light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      First thing in the head so the font downloads in parallel with the
      stylesheet. Without it the font is only discovered after the CSS parses,
      which is long enough to paint the fallback first.
    */}
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Applies the theme class before first paint so there is no flash of the
      wrong palette. Kept inline and dependency-free on purpose — it has to run
      before any module script loads. Mirrors src/lib/theme.ts.
    */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.classList.add(theme);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#222222" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="WIP" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wipdes" />
    <meta name="twitter:creator" content="@wipdes" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/twitter-image.png`} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body class="font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-6 focus:top-6 focus:z-[60] focus:bg-[var(--app-bg)] focus:px-4 focus:py-2 focus:text-[var(--app-fg)]"
    >
      Skip to content
    </a>
    <slot />
    <ConsoleMessage />
  </body>
</html>

<script>
  import Lenis from "lenis";
  import { initTheme } from "~/lib/theme";

  initTheme();

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  new Lenis({
    autoRaf: true,
    duration: prefersReducedMotion ? 0 : 1.1,
    easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    smoothWheel: !prefersReducedMotion,
    touchMultiplier: 1.5,
    syncTouch: false,
    anchors: true,
    infinite: false,
  });
</script>
