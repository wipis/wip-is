---
import Base from "~/layouts/Base.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import HomeAbout from "~/components/home/HomeAbout.astro";
import HomeHero from "~/components/home/HomeHero.astro";
import HomeIntro from "~/components/home/HomeIntro.astro";
import StarMarks from "~/components/home/StarMarks.astro";
import WorkList from "~/components/home/WorkList.astro";
import WorkGallery from "~/components/home/WorkGallery.astro";
---

<Base>
  <HomeHero />

  <main
    id="main"
    tabindex="-1"
    class="home-page bg-[--app-bg] min-h-screen text-[--app-fg]"
  >
    <article class="relative z-40 mx-auto grid max-w-[36rem] gap-9 md:gap-0">
      <div
        role="region"
        aria-label="Studio information"
        class="min-h-0 px-6 pt-12 pb-24"
      >
        <div class="relative grid max-w-[33rem] gap-6 pt-24 text-[1.0625rem]">
          <SiteHeader />
          <HomeIntro />
          <HomeAbout />
          <WorkList />
          <StarMarks />
        </div>
      </div>

      <div
        role="region"
        aria-label="Work imagery"
        hidden
        tabindex="0"
        data-scroll-pane
        class="min-h-0 min-w-0 px-6 pb-24 md:overflow-y-auto md:overscroll-contain md:pt-6"
      >
        <WorkGallery />
      </div>
    </article>

    <SiteFooter />
  </main>
</Base>
