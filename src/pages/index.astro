---
import Base from "~/layouts/Base.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import HomeAbout from "~/components/home/HomeAbout.astro";
import HomeIntro from "~/components/home/HomeIntro.astro";
import StarMarks from "~/components/home/StarMarks.astro";
import WorkList from "~/components/home/WorkList.astro";
---

<Base>
  <main
    id="main"
    tabindex="-1"
    class="home-page bg-[--app-bg] min-h-screen scroll-mt-6 text-[--app-fg]"
  >
    <SiteHeader />

    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-y-0 start-[calc(30rem+3rem)] z-[60] hidden w-px bg-[var(--app-border)] md:block"
    >
    </div>

    <article class="relative z-40 px-6 pt-24 pb-24">
      <div class="max-w-[30rem] grid gap-12 text-[1.0625rem]">
        <HomeIntro />
        <HomeAbout />
        <WorkList />
        <StarMarks />
      </div>
    </article>

    <SiteFooter />
  </main>
</Base>
